API_KEY=change-me-to-something-long
GRAFANA_PASSWORD=change-me
DOMAIN=zinalacina.com

# Public hostnames. Must match what you enter in the Cloudflare tunnel's
# "Published application routes". Change them if a name is already taken -
# check DNS before deleting an existing record, it may belong to another
# tunnel that is still in use.
DASH_HOST=llm-dash.zinalacina.com
LLM_HOST=llm.zinalacina.com
CHAT_HOST=chat.zinalacina.com

# Optional. Leave EMPTY to run without the public tunnel (local smoke test).
# Cloudflare Zero Trust -> Networks -> Tunnels -> create -> copy the eyJ... token.
TUNNEL_TOKEN=

# Hugging Face read token. Required for gated models; harmless otherwise.
HF_TOKEN=

# ── models ────────────────────────────────────────────────────────────────
# Pipeline validation only. Ungated, ~3GB.
MODEL_SMOKE=Qwen/Qwen2.5-1.5B-Instruct

# ACTIVE: Llama 3.1 70B. The canonical "70B-class" model and the one most
# serving benchmarks are published against, so the numbers are comparable to
# figures a reader already has a feel for.
# GATED - requires HF_TOKEN above and an accepted licence.
#   FP16 weights ~140GB · INT4 AWQ ~35GB
MODEL_FP16=meta-llama/Llama-3.1-70B-Instruct
MODEL_AWQ=hugging-quants/Meta-Llama-3.1-70B-Instruct-AWQ-INT4

# ALTERNATIVE: Qwen 2.5 72B. Apache 2.0, ungated, first-party AWQ.
# Marginally tighter at ~144GB FP16. Useful if Llama access lapses, or as a
# second data point if there is time.
# MODEL_FP16=Qwen/Qwen2.5-72B-Instruct
# MODEL_AWQ=Qwen/Qwen2.5-72B-Instruct-AWQ

# A100 is compute capability 8.0 - no native FP8 - so INT4 AWQ is the weight
# lever here, not FP8.

# Model cache. MUST be on the local NVMe - the boot disk is ~125GB and the
# FP16 weights are ~141GB. Local SSD is ephemeral: stopping the instance
# loses the download.
HF_CACHE=/mnt/models/huggingface

# Pinned by digest so the results in RESULTS.md stay reproducible. `latest`
# would silently change the thing under measurement.
VLLM_IMAGE=vllm/vllm-openai@sha256:0a51ea5b4ae2dc5d81890e5173f54203d2a3ae0cfffe51b8fd2afd4391bfd967
